{
  "name": "@bunnyfile/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "bunx @better-auth/cli@latest generate --output ./src/db/schema.ts --yes"
  },
  "dependencies": {
    "@bunnyfile/shared": "workspace:*",
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/cron": "1.4.2",
    "@elysiajs/swagger": "1.3.1",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "elysia": "1.4.30",
    "fflate": "0.8.3",
    "nodemailer": "10.0.10",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "0.31.11"
  }
}
